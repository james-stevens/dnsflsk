if test -f /opt/pems/certkey.pem -a -f /run/certkey.date \
		-a /opt/pems/certkey.pem -nt /run/certkey.date
    then
		touch -r /opt/pems/certkey.pem /run/certkey.date
		killall -HUP nginx
	fi
